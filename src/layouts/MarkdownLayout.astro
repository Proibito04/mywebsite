---
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import type { MarkdownHeading } from 'astro';

interface Props {
  frontmatter: any;
  headings?: MarkdownHeading[];
}

const { frontmatter, headings } = Astro.props;
const locale = frontmatter.lang === "it" ? "it" : "en";
---

<BaseLayout
  title={frontmatter.name || frontmatter.title}
  description={frontmatter.description}
  locale={locale}
>
  <div class="content-shell">
    <div class="flex flex-col lg:flex-row gap-8 items-start">
      <article class="prose prose-headings:text-sage-green prose-a:text-sage-green prose-code:text-off-white max-w-none flex-grow reader-card note-reader">
        <header class="note-header mb-12 border-b border-forest-muted pb-8">
          <h1 class="text-4xl font-bold mb-2">{frontmatter.name || frontmatter.title}</h1>
          <div class="note-meta text-off-white/60 flex gap-4 text-sm">
            <span>{new Date(frontmatter.created || frontmatter.pubDate).toLocaleDateString()}</span>
          </div>
        </header>
        <slot />
      </article>
      <TableOfContents headings={headings ?? []} />
    </div>
  </div>
</BaseLayout>
