---
import { ClientRouter } from "astro:transitions";
import Sidebar from "@/components/theme/Sidebar.astro";
import "../styles/global.css";
import "@fontsource/lexend";
import "@fontsource/fira-code";

const { title } = Astro.props;
---

<html
  lang="en"
  class="group layout"
  data-sidebar-collapsed="false"
>
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width"
    />
    <title>{title} | Edoardo Balzano</title>
    <ClientRouter />
    <script is:inline>
      // Prevent FOUC and margin shift by setting initial state immediately
      const isCollapsed = localStorage.getItem("sidebar-collapsed") === "true";
      document.documentElement.dataset.sidebarCollapsed = isCollapsed;
    </script>
  </head>
  <body>
    <Sidebar>

      <main
      class="group-data-[sidebar-collapsed=true]/layout:m-auto transition-all duration-300 p-8 max-w-7xl m-auto min-h-screen"
      >
      <slot />
    </main>
  </Sidebar>
  </body>
</html>
