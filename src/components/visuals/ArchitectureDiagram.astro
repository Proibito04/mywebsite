---
interface Props {
  locale: "en" | "it";
}

const { locale } = Astro.props;
const t =
  locale === "it"
    ? {
        label: "Architettura responsive di CTF Hammer",
        client: "Interfaccia operatore",
        clientNote: "SvelteKit · aggiornamenti live",
        protocol: "HTTP + WebSocket",
        core: "Backend Flask",
        coreNote: "API · progetti · coordinamento",
        capture: "Connessione",
        captureNode: "SSH / SCP manager",
        captureNote: "PCAP dalla vulbox",
        queue: "Coda asincrona",
        queueNode: "RabbitMQ → Celery",
        queueNote: "task di analisi",
        process: "Elaborazione",
        processNode: "tshark",
        processNote: "conversazioni e pattern",
        data: "Persistenza",
        dataNode: "MongoDB",
        dataNote: "progetti · conversazioni",
        orchestration: "Orchestrazione",
        orchestrationNode: "Docker Compose",
        orchestrationNote: "servizi isolati",
      }
    : {
        label: "Responsive CTF Hammer architecture",
        client: "Operator interface",
        clientNote: "SvelteKit · live updates",
        protocol: "HTTP + WebSocket",
        core: "Flask backend",
        coreNote: "API · projects · coordination",
        capture: "Connection",
        captureNode: "SSH / SCP manager",
        captureNote: "PCAP from vulbox",
        queue: "Async queue",
        queueNode: "RabbitMQ → Celery",
        queueNote: "analysis tasks",
        process: "Processing",
        processNode: "tshark",
        processNote: "conversations and patterns",
        data: "Persistence",
        dataNode: "MongoDB",
        dataNote: "projects · conversations",
        orchestration: "Orchestration",
        orchestrationNode: "Docker Compose",
        orchestrationNote: "isolated services",
      };
---

<div class="architecture" role="img" aria-label={t.label}>
  <div class="arch-layer arch-client">
    <span class="arch-layer-label">01 / client</span>
    <strong>{t.client}</strong>
    <small>{t.clientNote}</small>
  </div>

  <div class="arch-connector">
    <span>{t.protocol}</span>
    <i aria-hidden="true"></i>
  </div>

  <div class="arch-layer arch-core">
    <span class="arch-layer-label">02 / application</span>
    <strong>{t.core}</strong>
    <small>{t.coreNote}</small>
  </div>

  <div class="arch-branches">
    <div class="arch-branch">
      <span>{t.capture}</span>
      <strong>{t.captureNode}</strong>
      <small>{t.captureNote}</small>
    </div>
    <div class="arch-branch">
      <span>{t.queue}</span>
      <strong>{t.queueNode}</strong>
      <small>{t.queueNote}</small>
    </div>
    <div class="arch-branch">
      <span>{t.process}</span>
      <strong>{t.processNode}</strong>
      <small>{t.processNote}</small>
    </div>
    <div class="arch-branch">
      <span>{t.data}</span>
      <strong>{t.dataNode}</strong>
      <small>{t.dataNote}</small>
    </div>
    <div class="arch-branch">
      <span>{t.orchestration}</span>
      <strong>{t.orchestrationNode}</strong>
      <small>{t.orchestrationNote}</small>
    </div>
  </div>
</div>

<style>
  .architecture {
    display: grid;
    margin-top: 2rem;
    gap: 0;
  }

  .arch-layer {
    position: relative;
    display: grid;
    justify-self: center;
    width: min(100%, 24rem);
    padding: 1.15rem;
    border: 1px solid rgba(226, 242, 232, 0.2);
    border-radius: 0.3rem;
    background: #172622;
    text-align: center;
  }

  .arch-layer::before {
    position: absolute;
    top: -1px;
    left: -1px;
    width: 30%;
    height: 2px;
    background: #c6f04d;
    content: "";
  }

  .arch-layer strong,
  .arch-branch strong {
    color: #edf3ed;
    font-size: 0.86rem;
  }

  .arch-layer small,
  .arch-branch small {
    color: #8fa199;
    font-family: "Fira Code", monospace;
    font-size: 0.56rem;
  }

  .arch-layer-label,
  .arch-branch > span {
    margin-bottom: 0.35rem;
    color: #63d7d0;
    font-family: "Fira Code", monospace;
    font-size: 0.52rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .arch-connector {
    display: grid;
    justify-items: center;
    min-height: 4.2rem;
    color: #8fa199;
    font-family: "Fira Code", monospace;
    font-size: 0.53rem;
  }

  .arch-connector span {
    padding-top: 0.45rem;
  }

  .arch-connector i {
    width: 1px;
    height: 2.2rem;
    background: linear-gradient(#63d7d0, #c6f04d);
  }

  .arch-core::before {
    background: #63d7d0;
  }

  .arch-branches {
    position: relative;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    margin-top: 3.2rem;
    gap: 0.55rem;
  }

  .arch-branches::before {
    position: absolute;
    top: -1.6rem;
    right: 9%;
    left: 9%;
    height: 1px;
    background: rgba(226, 242, 232, 0.25);
    content: "";
  }

  .arch-branch {
    position: relative;
    display: grid;
    min-height: 7.5rem;
    align-content: start;
    padding: 0.85rem 0.7rem;
    border: 1px solid rgba(226, 242, 232, 0.14);
    border-radius: 0.25rem;
    background: rgba(15, 27, 24, 0.9);
  }

  .arch-branch::before {
    position: absolute;
    top: -1.6rem;
    left: 50%;
    width: 1px;
    height: 1.6rem;
    background: rgba(226, 242, 232, 0.25);
    content: "";
  }

  .arch-branch:nth-child(2)::after {
    position: absolute;
    right: -0.56rem;
    top: 50%;
    width: 0.56rem;
    height: 1px;
    background: #63d7d0;
    content: "";
  }

  .arch-branch:nth-child(3) {
    border-color: rgba(99, 215, 208, 0.35);
  }

  @media (max-width: 720px) {
    .arch-branches {
      grid-template-columns: 1fr;
      margin-top: 2rem;
      gap: 1.25rem;
    }

    .arch-branches::before {
      top: -2rem;
      bottom: 0;
      left: 0.5rem;
      width: 1px;
      height: auto;
    }

    .arch-branch {
      min-height: 0;
      margin-left: 1.5rem;
    }

    .arch-branch::before {
      top: 50%;
      left: -1.5rem;
      width: 1.5rem;
      height: 1px;
    }

    .arch-branch:nth-child(2)::after {
      display: none;
    }
  }
</style>
