---
import Download from "lucide-astro/Download";
import ExternalLink from "lucide-astro/ExternalLink";
import FileText from "lucide-astro/FileText";
import Printer from "lucide-astro/Printer";
import type { ProfileContent } from "../data/profile";
import { socialLinks } from "../data/profile";

interface Props {
  content: ProfileContent;
}

const { content } = Astro.props;
const { cv } = content;
---

<header class="cv-hero">
  <div class="narrow-shell cv-head">
    <div class="cv-head-copy">
      <p class="eyebrow">{cv.eyebrow}</p>
      <h1>{cv.title}</h1>
      <p class="cv-deck">{cv.intro}</p>
      <p class="cv-location">{cv.location}</p>
      <nav class="cv-contacts" aria-label={cv.contactTitle}>
        <a href="mailto:edoardo@edoardobalzano.com">edoardo@edoardobalzano.com</a>
        <a href={socialLinks.github} target="_blank" rel="noopener noreferrer">GitHub</a>
        <a href={socialLinks.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a href={socialLinks.htb} target="_blank" rel="noopener noreferrer">Hack The Box</a>
      </nav>
      <button class="print-button js-only" type="button" data-print-cv>
        <Printer size={16} aria-hidden="true" />
        {cv.print}
      </button>
    </div>
    <figure class="cv-portrait">
      <img
        src="/media/edoardo-balzano-portrait.webp"
        width="719"
        height="1080"
        alt={cv.portraitAlt}
        decoding="async"
        fetchpriority="high"
      />
    </figure>
  </div>
</header>

<article class="narrow-shell cv-document" aria-label={cv.title}>
  <section class="cv-section">
    <h2 class="cv-section-title">{cv.profileTitle}</h2>
    <p class="cv-profile-copy cv-screen-only">{cv.profile}</p>
    <p class="cv-print-only">{cv.profilePrint}</p>
  </section>

  <section class="cv-section cv-security">
    <h2 class="cv-section-title">{cv.practiceTitle}</h2>
    <div class="cv-screen-only">
      <h3>{content.credential.title}</h3>
      <p class="cv-meta">{content.credential.issuer}</p>
      <p>{cv.security.introduction}</p>
      <ul class="cv-highlights">
        {cv.security.highlights.map((highlight) => <li>{highlight}</li>)}
      </ul>
      <p>{cv.security.practice}</p>
    </div>
    <p class="cv-print-only">{cv.security.printSummary}</p>
    <div class="cv-evidence-links">
      <a href={content.credential.pdf} download>
        <Download size={14} aria-hidden="true" /> {cv.credentialPdfLabel}
      </a>
      <a href={socialLinks.htb} target="_blank" rel="noopener noreferrer">
        <ExternalLink size={13} aria-hidden="true" /> {cv.credentialHtbLabel}
      </a>
      <a href="/writeups">
        <FileText size={14} aria-hidden="true" /> {cv.credentialWriteupsLabel}
      </a>
    </div>
  </section>

  <section class="cv-section">
    <h2 class="cv-section-title">{cv.projectsTitle}</h2>
    <div class="cv-entries">
      {content.projects.map((project) => (
        <article class:list={["cv-project-entry", { "cv-featured-project": project.featured }]}>
          <div class="cv-entry-heading">
            <h3>
              <a href={project.href} target="_blank" rel="noopener noreferrer">
                {project.title} <ExternalLink size={13} aria-hidden="true" />
              </a>
            </h3>
            <span class="cv-meta cv-screen-only">{project.status} · {project.role}</span>
          </div>
          <div class="cv-screen-only">
            <p>{project.detail}</p>
            {project.featured && project.outcome && <p class="cv-project-result">{project.outcome}</p>}
            {project.featured && project.limitation && <p class="cv-project-limit">{project.limitation}</p>}
            <p class="cv-stack"><span>{cv.skillsToolsLabel}:</span> {project.stack.join(" · ")}</p>
          </div>
          <p class="cv-print-only">{cv.projectPrintSummaries[project.id] ?? project.summary}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="cv-section">
    <h2 class="cv-section-title">{cv.educationTitle}</h2>
    <ol class="cv-entries cv-education">
      {content.education.map((experience) => (
        <li>
          <div class="cv-entry-heading">
            <div class="cv-institution-heading">
              {experience.logo && (
                <img
                  class="cv-institution-logo"
                  src={experience.logo}
                  alt={experience.logoAlt ?? experience.organization}
                  width="80"
                  height="40"
                  loading="eager"
                />
              )}
              <h3>{experience.role} <span class="cv-institution">· {experience.organization}</span></h3>
            </div>
            <span class="cv-meta">{experience.period}</span>
          </div>
          <p class="cv-screen-only">{experience.summary}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="cv-section">
    <h2 class="cv-section-title">{cv.skillsTitle}</h2>
    <dl class="cv-skills">
      {content.skillGroups.map((group) => (
        <div>
          <dt>{group.title}</dt>
          <dd>
            <span class="cv-screen-only cv-skill-context">{group.summary}</span>
            <span>{group.skills.join(" · ")}</span>
          </dd>
        </div>
      ))}
    </dl>
    <p class="cv-meta cv-screen-only">{cv.skillsContext}</p>
  </section>

  <section class="cv-section">
    <h2 class="cv-section-title">{cv.languagesTitle}</h2>
    <p class="cv-languages">
      {content.languages.map((language) => `${language.name} (${language.level})`).join(" · ")}
    </p>
  </section>

  <section class="cv-section cv-work">
    <h2 class="cv-section-title">{cv.leadershipTitle}</h2>
    <ul class="cv-entries">
      {content.leadership.map((experience) => (
        <li>
          <div class="cv-entry-heading">
            <h3>{experience.organization} <span class="cv-institution">· {experience.role}</span></h3>
            <span class="cv-meta">{experience.period}</span>
          </div>
          <p class="cv-screen-only">{cv.workSummaries[experience.organization]}</p>
        </li>
      ))}
    </ul>
  </section>

  <p class="cv-privacy-consent">{cv.privacyConsent}</p>
</article>

<script>
  function initializePrintButton() {
    const button = document.querySelector<HTMLButtonElement>("[data-print-cv]");
    if (!button || button.dataset.initialized === "true") return;
    button.dataset.initialized = "true";
    button.addEventListener("click", () => window.print());
  }

  initializePrintButton();
  document.addEventListener("astro:after-swap", initializePrintButton);
</script>
