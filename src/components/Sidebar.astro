---
import Home from "lucide-astro/Home";
import Notebook from "lucide-astro/Notebook";
import Terminal from "lucide-astro/Terminal";
import User from "lucide-astro/User";
import ChevronLeft from "lucide-astro/ChevronLeft";
import ChevronRight from "lucide-astro/ChevronRight";

const navItems = [
  { href: '/', icon: Home, label: 'Home' },
  { href: '/notes', icon: Notebook, label: 'Notes' },
  { href: '/writeups', icon: Terminal, label: 'Writeups' },
  { href: '/cv', icon: User, label: 'About/CV' },
];
---

<aside id="sidebar" class="fixed top-0 left-0 h-full bg-forest-dark border-r border-forest-muted transition-all duration-300 z-50 w-64 group data-[collapsed=true]:w-16">
  <div class="flex flex-col h-full p-4 group-data-[collapsed=true]:px-3 transition-all duration-300 overflow-hidden">
    <div class="mb-8 flex items-center justify-between group-data-[collapsed=true]:justify-center min-h-[40px]">
      <span class="text-xl font-bold text-sage-green group-data-[collapsed=true]:hidden whitespace-nowrap">Edoardo B.</span>
      <button id="sidebar-toggle" class="p-1 hover:bg-forest-muted rounded-md text-sage-green transition-colors">
        <div id="toggle-icon-expanded" class="group-data-[collapsed=true]:hidden"><ChevronLeft /></div>
        <div id="toggle-icon-collapsed" class="hidden group-data-[collapsed=true]:block"><ChevronRight /></div>
      </button>
    </div>
 
    <nav class="space-y-4 flex-grow flex flex-col items-center group-data-[collapsed=false]:items-stretch">
      {navItems.map(({ href, icon: Icon, label }) => (
        <a 
          href={href} 
          class="flex items-center gap-4 p-2 hover:bg-forest-muted rounded-lg text-off-white group/link transition-all duration-300 group-data-[collapsed=true]:justify-center group-data-[collapsed=true]:gap-0 group-data-[collapsed=true]:w-10 group-data-[collapsed=true]:h-10 group-data-[collapsed=true]:p-0"
        >
          <Icon class="w-6 h-6 shrink-0 text-sage-green" />
          <span class="group-data-[collapsed=true]:hidden whitespace-nowrap font-medium text-sm">{label}</span>
        </a>
      ))}
    </nav>
    </div>
  </div>
</aside>

<script>
  function setupSidebar() {
    const sidebar = document.getElementById('sidebar');
    const toggle = document.getElementById('sidebar-toggle');
    if (!sidebar || !toggle) return;

    // Load initial state and sync with global layout state
    const isCollapsed = localStorage.getItem('sidebar-collapsed') === 'true';
    sidebar.dataset.collapsed = String(isCollapsed);
    document.documentElement.dataset.sidebarCollapsed = String(isCollapsed);

    // Remove existing listener to prevent duplicates across page loads
    const newToggle = toggle.cloneNode(true);
    toggle.parentNode?.replaceChild(newToggle, toggle);

    newToggle.addEventListener('click', () => {
      const currentlyCollapsed = sidebar.dataset.collapsed === 'true';
      const newState = !currentlyCollapsed;
      
      // Update local and global state
      sidebar.dataset.collapsed = String(newState);
      document.documentElement.dataset.sidebarCollapsed = String(newState);
      localStorage.setItem('sidebar-collapsed', String(newState));
    });
  }

  document.addEventListener('astro:page-load', () => {
    setupSidebar();
  });
</script>
