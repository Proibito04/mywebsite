---
import type { CollectionEntry } from "astro:content";
import ArrowDown from "lucide-astro/ArrowDown";
import ArrowRight from "lucide-astro/ArrowRight";
import ArrowUpRight from "lucide-astro/ArrowUpRight";
import ExternalLink from "lucide-astro/ExternalLink";
import Github from "lucide-astro/Github";
import Linkedin from "lucide-astro/Linkedin";
import Mail from "lucide-astro/Mail";
import ShieldCheck from "lucide-astro/ShieldCheck";
import CertificateCard from "./CertificateCard.astro";
import EvidenceExplorer from "./EvidenceExplorer.astro";
import ArchitectureDiagram from "./visuals/ArchitectureDiagram.astro";
import HeroInfrastructure from "./visuals/HeroInfrastructure.astro";
import HomelabDiagram from "./visuals/HomelabDiagram.astro";
import JourneyGraphic from "./visuals/JourneyGraphic.astro";
import type { ProfileContent } from "../data/profile";

interface Props {
  content: ProfileContent;
  latestNotes: CollectionEntry<"notes">[];
  latestWriteups: CollectionEntry<"writeups">[];
}

const { content, latestNotes, latestWriteups } = Astro.props;
const { locale } = content;
const cvHref = locale === "it" ? "/it/cv" : "/cv";
const dateFormatter = new Intl.DateTimeFormat(locale === "it" ? "it-IT" : "en-GB", {
  year: "numeric",
  month: "short",
  day: "numeric",
});
const sourceLabel = locale === "it" ? "Apri progetto" : "View project";
const outcomeLabel = locale === "it" ? "Evidenza operativa" : "Operational evidence";
const limitationLabel = locale === "it" ? "Limite osservato" : "Observed limitation";
const interfaceEvidence = content.visualEvidence.find(
  (item) => item.id === "ctf-hammer-interface",
);
const flagship = content.projects.find((project) => project.featured);
const supportingProjects = content.projects.filter((project) => !project.featured);
---

<section class="hero" aria-labelledby="hero-title">
  <div class="shell hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">{content.hero.kicker}</p>
      <h1 id="hero-title">{content.hero.title}</h1>
      <p class="hero-intro">{content.hero.introduction}</p>
      <div class="hero-actions">
        <a class="button button-primary" href="#evidence">
          {content.hero.primaryAction}
          <ArrowDown size={16} aria-hidden="true" />
        </a>
        <a class="button" href={cvHref}>
          {content.hero.cvAction}
          <ArrowRight size={16} aria-hidden="true" />
        </a>
        <a class="button button-quiet" href="mailto:edoardo@edoardobalzano.com">
          <Mail size={16} aria-hidden="true" />
          {content.hero.contactAction}
        </a>
      </div>
      <p class="hero-availability">
        <span class="status-dot" aria-hidden="true"></span>
        {content.hero.availability}
      </p>
    </div>
    <div class="hero-visual">
      <HeroInfrastructure label={content.hero.graphicLabel} locale={locale} />
    </div>
  </div>
</section>

<section class="section" id="evidence" aria-labelledby="evidence-heading">
  <div class="shell">
    <div class="section-heading">
      <div>
        <p class="eyebrow">{content.home.proofKicker}</p>
        <h2 id="evidence-heading">{content.home.proofTitle}</h2>
      </div>
      <p>{content.home.proofIntro}</p>
    </div>
    <EvidenceExplorer items={content.evidence} labels={content.explorerLabels} />
  </div>
</section>

<section class="section section-soft" id="projects" aria-labelledby="projects-heading">
  <div class="shell">
    <div class="section-heading">
      <div>
        <p class="eyebrow">{content.home.projectKicker}</p>
        <h2 id="projects-heading">{content.home.projectTitle}</h2>
      </div>
      <p>{content.home.projectIntro}</p>
    </div>

    {
      flagship && (
        <article class="project-card project-card-featured">
          <span class="project-number">{flagship.number}</span>
          <div>
            <p class="project-status">{flagship.status}</p>
            <h3>{flagship.title}</h3>
            <p class="project-summary">{flagship.summary}</p>
            <p class="project-detail">{flagship.detail}</p>
          </div>
          <aside class="project-meta">
            <p class="project-role">{flagship.role}</p>
            <ul class="tags" aria-label="CTF Hammer technologies">
              {flagship.stack.map((tag) => <li>{tag}</li>)}
            </ul>
            <a
              class="button"
              href={flagship.href}
              target="_blank"
              rel="noopener noreferrer"
            >
              {sourceLabel}
              <ArrowUpRight size={15} aria-hidden="true" />
            </a>
          </aside>
          <div class="project-findings">
            {flagship.outcome && (
              <div class="finding">
                <strong>{outcomeLabel}</strong>
                {flagship.outcome}
              </div>
            )}
            {flagship.limitation && (
              <div class="finding finding-limit">
                <strong>{limitationLabel}</strong>
                {flagship.limitation}
              </div>
            )}
          </div>
        </article>
      )
    }

    <div class="supporting-project-grid">
      {
        supportingProjects.map((project) => (
          <article class="supporting-project">
            <div class="supporting-project-head">
              <span class="project-number">{project.number}</span>
              <p class="project-status">{project.status}</p>
            </div>
            <h3>{project.title}</h3>
            <p class="project-summary">{project.summary}</p>
            <p class="project-detail">{project.detail}</p>
            <ul class="tags" aria-label={`${project.title} technologies`}>
              {project.stack.map((tag) => <li>{tag}</li>)}
            </ul>
            <a
              class="text-link"
              href={project.href}
              target="_blank"
              rel="noopener noreferrer"
            >
              {sourceLabel} <ArrowUpRight size={13} aria-hidden="true" />
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>

<section class="section section-dark" aria-labelledby="architecture-heading">
  <div class="shell">
    <div class="flagship-visuals">
      {
        interfaceEvidence?.src && (
          <figure class="interface-shot">
            <img
              src={interfaceEvidence.src}
              alt={interfaceEvidence.alt}
              width="897"
              height="1363"
              loading="lazy"
              decoding="async"
            />
            <figcaption>{content.home.interfaceCaption}</figcaption>
          </figure>
        )
      }
      <div class="architecture-wrap">
        <p class="eyebrow">CTF Hammer / architecture</p>
        <h3 id="architecture-heading">{content.home.architectureTitle}</h3>
        <p>{content.home.architectureIntro}</p>
        <ArchitectureDiagram locale={locale} />
      </div>
    </div>
  </div>
</section>

<section class="section" aria-labelledby="homelab-heading">
  <div class="shell homelab-layout">
    <div class="section-heading">
      <div>
        <p class="eyebrow">{content.home.homelabKicker}</p>
        <h2 id="homelab-heading">{content.home.homelabTitle}</h2>
      </div>
      <p>{content.home.homelabIntro}</p>
    </div>
    <HomelabDiagram locale={locale} />
  </div>
</section>

<section class="section section-soft" aria-labelledby="journey-heading">
  <div class="shell">
    <div class="journey-card">
      <div>
        <p class="eyebrow">{content.home.journeyKicker}</p>
        <h2 id="journey-heading">{content.home.journeyTitle}</h2>
        <p>{content.home.journeyIntro}</p>
      </div>
      <JourneyGraphic locale={locale} />
    </div>
  </div>
</section>

<section class="section" aria-labelledby="credential-heading">
  <div class="shell">
    <h2 id="credential-heading" class="sr-only">{content.home.credentialTitle}</h2>
    <CertificateCard
      credential={content.credential}
      labels={content.home}
      locale={locale}
    />
  </div>
</section>

<section class="section section-soft" id="writing" aria-labelledby="writing-heading">
  <div class="shell">
    <div class="section-heading">
      <div>
        <p class="eyebrow">{content.home.writingKicker}</p>
        <h2 id="writing-heading">{content.home.writingTitle}</h2>
      </div>
      <p>{content.home.writingIntro}</p>
    </div>
    <div class="writing-grid">
      <section class="writing-column" aria-labelledby="notes-title">
        <div class="writing-head">
          <h3 id="notes-title">{content.home.notesTitle}</h3>
          <a class="text-link" href="/notes">
            {content.home.viewAll} <span aria-hidden="true">↗</span>
          </a>
        </div>
        {
          latestNotes.length ? (
            <ul class="entry-list">
              {latestNotes.map((note) => (
                <li>
                  <a class="entry-link" href={`/notes/${note.id}`}>
                    <span class="entry-title">{note.data.title}</span>
                    <span class="language-badge">{note.data.lang}</span>
                    <span class="entry-meta">
                      {dateFormatter.format(note.data.pubDate)}
                    </span>
                    <p class="entry-description">{note.data.description}</p>
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <p>{content.home.noEntries}</p>
          )
        }
      </section>
      <section class="writing-column" aria-labelledby="writeups-title">
        <div class="writing-head">
          <h3 id="writeups-title">{content.home.writeupsTitle}</h3>
          <a class="text-link" href="/writeups">
            {content.home.viewAll} <span aria-hidden="true">↗</span>
          </a>
        </div>
        {
          latestWriteups.length ? (
            <ul class="entry-list">
              {latestWriteups.map((writeup) => (
                <li>
                  <a class="entry-link" href={`/writeups/${writeup.id}`}>
                    <span class="entry-title">{writeup.data.name}</span>
                    <span class="language-badge">{writeup.data.lang}</span>
                    <span class="entry-meta">
                      {dateFormatter.format(writeup.data.created)}
                    </span>
                    <p class="entry-description">
                      {writeup.data.difficulty} ·{" "}
                      {writeup.data.tags.slice(0, 3).join(" · ") || "HTB"}
                    </p>
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <p>{content.home.noEntries}</p>
          )
        }
      </section>
    </div>
  </div>
</section>

<section class="section" aria-labelledby="profiles-heading">
  <div class="shell">
    <div class="section-heading">
      <div>
        <p class="eyebrow">{content.home.profilesKicker}</p>
        <h2 id="profiles-heading">{content.home.profilesTitle}</h2>
      </div>
      <p>{content.home.profilesIntro}</p>
    </div>
    <div class="profiles-grid">
      {
        content.externalProfiles.map((profile, index) => (
          <a
            class={`profile-card profile-card-${profile.id}`}
            href={profile.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${profile.title}: ${content.home.profileAction}`}
          >
            <span class="profile-card-icon" aria-hidden="true">
              {profile.id === "github" && <Github size={22} />}
              {profile.id === "htb" && <ShieldCheck size={22} />}
              {profile.id === "linkedin" && <Linkedin size={22} />}
            </span>
            <span class="profile-card-index" aria-hidden="true">
              / 0{index + 1}
            </span>
            <h3>{profile.title}</h3>
            <p class="profile-handle">{profile.handle}</p>
            <p class="profile-summary">{profile.summary}</p>
            <span class="profile-action">
              {content.home.profileAction}
              <ExternalLink size={14} aria-hidden="true" />
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>
