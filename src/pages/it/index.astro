---
import { getCollection } from "astro:content";
import PortfolioPage from "../../components/PortfolioPage.astro";
import { profiles } from "../../data/profile";
import BaseLayout from "../../layouts/BaseLayout.astro";

const latestNotes = (await getCollection("notes"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
const latestWriteups = (await getCollection("writeups"))
  .filter((entry) => !entry.data.private)
  .sort((a, b) => b.data.created.valueOf() - a.data.created.valueOf())
  .slice(0, 3);
const content = profiles.it;
---

<BaseLayout
  title={content.meta.homeTitle}
  description={content.meta.homeDescription}
  locale="it"
  canonicalPath="/it"
  alternatePath="/"
>
  <PortfolioPage
    content={content}
    latestNotes={latestNotes}
    latestWriteups={latestWriteups}
  />
</BaseLayout>
