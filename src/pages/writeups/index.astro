---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const writeups = (await getCollection("writeups"))
  .filter((entry) => !entry.data.private)
  .sort((a, b) => b.data.created.valueOf() - a.data.created.valueOf());
const dateFormatter = new Intl.DateTimeFormat("en-GB", {
  year: "numeric",
  month: "short",
  day: "numeric",
});
---

<BaseLayout
  title="HTB Writeups"
  description="Public Hack The Box machine and challenge writeups by Edoardo Balzano."
>
  <div class="content-shell">
    <header class="listing-head">
      <p class="eyebrow">Attack paths / reasoning</p>
      <h1>HTB writeups</h1>
      <p>
        Public records of reconnaissance, exploitation, and lessons learned.
        Entries remain in their original language; private drafts are never published.
      </p>
    </header>
    <div class="content-list">
      {
        writeups.map((writeup) => (
          <a href={`/writeups/${writeup.id}`} class="content-card">
            <div>
              <h2>{writeup.data.name}</h2>
              <span class="language-badge">{writeup.data.lang}</span>
            </div>
            <span class="content-card-meta">
              {dateFormatter.format(writeup.data.created)} · {writeup.data.difficulty}
            </span>
            <p>{writeup.data.tags.join(" · ") || "Hack The Box"}</p>
          </a>
        ))
      }
    </div>
  </div>
</BaseLayout>
