---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import Calendar from "lucide-astro/Calendar";
import Tag from "lucide-astro/Tag";
import Activity from "lucide-astro/Activity";
import LinkIcon from "lucide-astro/Link";
import Edit3 from "lucide-astro/Edit3";
import Lock from "lucide-astro/Lock";
import ASTCodeBlock from "@/components/ASTCodeBlock.astro";

// 1. Core Unified Pipeline Requirements
import { unified } from "unified";
import remarkParse from "remark-parse";
import remarkRehype from "remark-rehype";
import rehypeStringify from "rehype-stringify";
// import { visit } from "unist-util-visit"; // For custom rehype manipulation
export async function getStaticPaths() {
  const writeups = await getCollection("writeups");
  return writeups.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { headings } = await render(entry);

// 2. Define Custom Rehype Plugin (For "better control" over standard HTML elements)
const myCustomRehypePlugin = () => {
  return (tree: any) => {
    // Example: visit(tree, 'element', (node) => { ... });
  };
};

// 3. Setup Processors
const parseProcessor = unified().use(remarkParse);

const htmlProcessor = unified()
  .use(remarkRehype, { allowDangerousHtml: true })
  .use(myCustomRehypePlugin)
  .use(rehypeStringify, { allowDangerousHtml: true });

// 4. Parse raw markdown string into AST
const mdast = parseProcessor.parse(entry.body);

// 5. Traverse AST to build "Renderable Objects"
const nodes = await Promise.all(
  mdast.children.map(async (node) => {
    if (node.type === "code") {
      return {
        type: "code",
        lang: node.lang || "plaintext",
        content: node.value,
      };
    }

    const hastNode = await htmlProcessor.run({
      // We wrap the single block in a "root" to satisfy unified
      type: "root",
      children: [node as any],
    });

    // We stringify the resulting hast (HTML AST)
    const compiledHtml = String(htmlProcessor.stringify(hastNode));

    return {
      type: "html",
      content: compiledHtml,
    };
  }),
);

// Determine badge color based on difficulty
const diffColor =
  entry.data.difficulty?.toLowerCase() === "hard"
    ? "badge-error"
    : entry.data.difficulty?.toLowerCase() === "medium"
      ? "badge-warning"
      : "badge-success";

const createdDate = new Date(entry.data.created).toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
const modifiedDate = entry.data.modified
  ? new Date(entry.data.modified).toLocaleDateString("en-US", {
      year: "numeric",
      month: "long",
      day: "numeric",
    })
  : null;
---

<BaseLayout title={entry.data.name}>
  <div class="text-sm breadcrumbs mb-6 text-off-white/70">
    <ul>
      <li>
        <a
          href="/"
          class="hover:text-sage-green transition-colors"
          >Home</a
        >
      </li>
      <li>
        <a
          href="/writeups"
          class="hover:text-sage-green transition-colors"
          >Writeups</a
        >
      </li>
      <li class="text-sage-green font-medium">{entry.data.name}</li>
    </ul>
  </div>

  <div class="flex flex-col lg:flex-row gap-8 items-start">
    <div class="w-full grow min-w-0">
      <div
        class="card bg-forest-dark/50 border border-forest-muted mb-12 shadow-xl shadow-forest-deep/20 rounded-2xl"
      >
        <div class="card-body p-6 sm:p-10">
          <div
            class="flex flex-col sm:flex-row sm:items-start justify-between gap-4 mb-6"
          >
            <h1 class="text-4xl sm:text-5xl font-bold m-0 text-off-white">
              {entry.data.name}
            </h1>

            <div class="flex gap-2 items-center flex-wrap mt-2 sm:mt-0">
              {
                entry.data.private && (
                  <div class="badge badge-neutral gap-2 p-3 font-semibold">
                    <Lock class="w-3 h-3" />
                    Private
                  </div>
                )
              }
              {
                entry.data.difficulty && (
                  <div
                    class={`badge ${diffColor} font-bold uppercase tracking-wider p-3 shadow-sm`}
                  >
                    <Activity class="w-4 h-4 mr-1" />
                    {entry.data.difficulty}
                  </div>
                )
              }
            </div>
          </div>

          <div
            class="flex flex-wrap gap-x-6 gap-y-3 text-sm text-off-white/80 font-medium font-mono"
          >
            <div class="flex items-center gap-2">
              <Calendar class="w-4 h-4 text-sage-green" />
              <span>{createdDate}</span>
            </div>

            {
              modifiedDate && (
                <div
                  class="flex items-center gap-2"
                  title="Last Modified"
                  aria-label="Last Modified"
                >
                  <Edit3 class="w-4 h-4 text-sage-green" />
                  <span>{modifiedDate}</span>
                </div>
              )
            }

            {
              entry.data.machine_link && (
                <div class="flex items-center gap-2">
                  <LinkIcon class="w-4 h-4 text-sage-green" />
                  <a
                    href={entry.data.machine_link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="hover:text-sage-green transition-colors no-underline"
                  >
                    Machine Link
                  </a>
                </div>
              )
            }
          </div>

          {
            entry.data.tags && entry.data.tags.length > 0 && (
              <>
                <div class="divider before:bg-forest-muted/30 after:bg-forest-muted/30 my-6" />
                <div class="flex gap-2 flex-wrap items-center">
                  <Tag class="w-4 h-4 text-sage-green/70 mr-1" />
                  {entry.data.tags.map((tag: unknown) => (
                    <span class="badge badge-outline border-forest-muted/50 text-off-white/80 hover:bg-forest-muted/20 hover:text-sage-green hover:border-sage-green transition-all">
                      {tag}
                    </span>
                  ))}
                </div>
              </>
            )
          }
        </div>
      </div>

      <article
        class="prose  max-w-none text-off-white
        prose-headings:text-sage-green prose-a:text-sage-green
        prose-img:rounded-2xl prose-img:shadow-lg
        selection:bg-sage-green/30 px-2 sm:px-0 dark:prose-invert"
      >
        {
          nodes.map((node) => {
            if (node.type === "code") {
              return (
                <ASTCodeBlock
                  lang={node.lang ?? ""}
                  code={node.content}
                />
              );
            }
            if (node.type === "html") {
              return <Fragment set:html={node.content} />;
            }
            return null;
          })
        }
      </article>
    </div>

    <div class="hidden lg:block w-64 shrink-0 sticky top-8">
      <TableOfContents headings={headings} />
    </div>
  </div>
</BaseLayout>
