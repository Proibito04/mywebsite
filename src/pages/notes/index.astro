---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const notes = (await getCollection("notes")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const dateFormatter = new Intl.DateTimeFormat("en-GB", {
  year: "numeric",
  month: "short",
  day: "numeric",
});
---

<BaseLayout
  title="Cybersecurity Notes"
  description="Study notes on cybersecurity, systems, networks, and infrastructure."
>
  <div class="content-shell notes-index">
    <header class="listing-head">
      <p class="eyebrow">Study log</p>
      <h1>Cybersecurity notes</h1>
      <p>
        Concepts, experiments, and implementation details captured while learning.
        Each entry stays in its original language.
      </p>
    </header>
    <div class="content-list">
      {
        notes.map((note) => (
          <a href={`/notes/${note.id}`} class="content-card">
            <div>
              <h2>{note.data.title}</h2>
              <span class="language-badge">{note.data.lang}</span>
            </div>
            <span class="content-card-meta">{dateFormatter.format(note.data.pubDate)}</span>
            <p>{note.data.description}</p>
            <ul class="tags">
              {note.data.tags.map((tag) => <li>{tag}</li>)}
            </ul>
          </a>
        ))
      }
    </div>
  </div>
</BaseLayout>
